{
  "name": "rest-api-node",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prestart": "npm run build",
    "seed:phones": "ts-node src/scripts/seed-phone-products.ts",
    "seed:serialized-inventory": "ts-node src/scripts/seed-serialized-inventory-example.ts",
    "perf:health": "autocannon -c 50 -d 30 http://localhost:5002/api/v1/health",
    "perf:products": "autocannon -c 50 -d 30 http://localhost:5002/api/v1/products",
    "profile": "clinic doctor -- node dist/server.js"
  },
  "keywords": [],
  "author": "",
