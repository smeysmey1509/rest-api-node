NODE_ENV=development
PORT=5002
MONGO_URI=mongodb://localhost:27017/rest-api-node
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=replace-with-access-token-secret
JWT_REFRESH_SECRET=replace-with-refresh-token-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Optional service-to-service fallback for protected endpoints.
API_KEY=replace-with-service-api-key
API_KEY_USER_ID=service-account
API_KEY_ROLE=ADMIN

# Optional infrastructure.
REDIS_URL=redis://localhost:6379
PROXY_TARGET=

# Payment config.
# Do not put card numbers, CVV values, or provider secrets in frontend code.
