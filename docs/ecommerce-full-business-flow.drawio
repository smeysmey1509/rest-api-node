<mxfile host="app.diagrams.net" modified="2026-07-12T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" pages="6">
  <diagram id="system-overview" name="1. System Overview">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p1-title" value="E-commerce backend — system architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="20" width="850" height="40" as="geometry"/></mxCell>
        <mxCell id="p1-sub" value="V1 recommendation: all services use one MongoDB database until direct cross-service imports are replaced by HTTP clients and events." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=13" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1120" height="52" as="geometry"/></mxCell>

        <mxCell id="p1-client" value="&lt;b&gt;Clients&lt;/b&gt;&lt;br&gt;Web application&lt;br&gt;Mobile application&lt;br&gt;Postman / external integrations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14" vertex="1" parent="1"><mxGeometry x="40" y="205" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="p1-gateway" value="&lt;b&gt;API Gateway :5002&lt;/b&gt;&lt;br&gt;Public entry point&lt;br&gt;Route proxying&lt;br&gt;CORS / request ID&lt;br&gt;Rate limits / health aggregation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14" vertex="1" parent="1"><mxGeometry x="330" y="190" width="240" height="150" as="geometry"/></mxCell>

        <mxCell id="p1-auth" value="&lt;b&gt;Auth Service :5101&lt;/b&gt;&lt;br&gt;Register / login&lt;br&gt;JWT / refresh sessions&lt;br&gt;Role verification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13" vertex="1" parent="1"><mxGeometry x="650" y="145" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="p1-user" value="&lt;b&gt;User Service :5102&lt;/b&gt;&lt;br&gt;Customer profiles&lt;br&gt;Addresses&lt;br&gt;Account status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13" vertex="1" parent="1"><mxGeometry x="900" y="145" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="p1-catalog" value="&lt;b&gt;Catalog Service :5103&lt;/b&gt;&lt;br&gt;Products / variants&lt;br&gt;Categories / brands&lt;br&gt;Reviews / wishlist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13" vertex="1" parent="1"><mxGeometry x="1150" y="145" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="p1-inventory" value="&lt;b&gt;Inventory Service :5104&lt;/b&gt;&lt;br&gt;Stock-in / reserve / sell&lt;br&gt;Serial / IMEI units&lt;br&gt;Locations / suppliers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13" vertex="1" parent="1"><mxGeometry x="650" y="300" width="220" height="115" as="geometry"/></mxCell>
        <mxCell id="p1-order" value="&lt;b&gt;Order Service :5105&lt;/b&gt;&lt;br&gt;Cart / coupons&lt;br&gt;Checkout / orders&lt;br&gt;Order state transitions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13" vertex="1" parent="1"><mxGeometry x="900" y="300" width="220" height="115" as="geometry"/></mxCell>
        <mxCell id="p1-payment" value="&lt;b&gt;Payment Service :5106&lt;/b&gt;&lt;br&gt;Payment intents&lt;br&gt;Provider webhooks&lt;br&gt;Refunds / idempotency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13" vertex="1" parent="1"><mxGeometry x="1150" y="300" width="220" height="115" as="geometry"/></mxCell>

        <mxCell id="p1-mongo" value="&lt;b&gt;MongoDB V1 — one database&lt;/b&gt;&lt;br&gt;Identity: users, sessions, addresses&lt;br&gt;Catalog: products, variants, categories, brands&lt;br&gt;Inventory: units, balances, movements, reservations&lt;br&gt;Sales: carts, coupons, orders&lt;br&gt;Billing: payments, invoices, receipts, refunds&lt;br&gt;Fulfillment: shipments, returns" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=14;fontSize=13" vertex="1" parent="1"><mxGeometry x="650" y="530" width="470" height="220" as="geometry"/></mxCell>
        <mxCell id="p1-redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;Cart cache&lt;br&gt;Rate-limit counters&lt;br&gt;Distributed locks&lt;br&gt;Short-lived reservation lookup" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13" vertex="1" parent="1"><mxGeometry x="1190" y="530" width="210" height="150" as="geometry"/></mxCell>
        <mxCell id="p1-rabbit" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;br&gt;user.created&lt;br&gt;order.created&lt;br&gt;payment.completed&lt;br&gt;inventory.reserved / released&lt;br&gt;shipment.delivered" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13" vertex="1" parent="1"><mxGeometry x="1440" y="530" width="230" height="165" as="geometry"/></mxCell>

        <mxCell id="p1-workers" value="&lt;b&gt;Background workers&lt;/b&gt;&lt;br&gt;Expire reservations&lt;br&gt;Publish outbox events&lt;br&gt;Email/SMS notifications&lt;br&gt;Retry failed events&lt;br&gt;Reconcile payments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13" vertex="1" parent="1"><mxGeometry x="1440" y="265" width="230" height="155" as="geometry"/></mxCell>
        <mxCell id="p1-provider" value="&lt;b&gt;External providers&lt;/b&gt;&lt;br&gt;Card / bank gateway&lt;br&gt;Carrier API&lt;br&gt;Email / SMS provider&lt;br&gt;Object storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13" vertex="1" parent="1"><mxGeometry x="1440" y="100" width="230" height="125" as="geometry"/></mxCell>

        <mxCell id="p1-note1" value="&lt;b&gt;Internal reference rule&lt;/b&gt;&lt;br&gt;Use MongoDB ObjectId for same-database references." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10" vertex="1" parent="1"><mxGeometry x="40" y="520" width="270" height="75" as="geometry"/></mxCell>
        <mxCell id="p1-note2" value="&lt;b&gt;Public reference rule&lt;/b&gt;&lt;br&gt;Expose unique immutable business IDs: orderNumber, invoiceNumber, SKU, paymentNumber." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10" vertex="1" parent="1"><mxGeometry x="40" y="615" width="270" height="95" as="geometry"/></mxCell>
        <mxCell id="p1-note3" value="&lt;b&gt;Future V2&lt;/b&gt;&lt;br&gt;After removing all @services/... imports, give each service its own database and communicate through versioned HTTP contracts and reliable events." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10" vertex="1" parent="1"><mxGeometry x="40" y="735" width="530" height="95" as="geometry"/></mxCell>

        <mxCell id="p1-e1" value="HTTPS / JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p1-client" target="p1-gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e2" value="Auth routes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p1-gateway" target="p1-auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e3" value="User routes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p1-gateway" target="p1-user"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e4" value="Catalog routes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p1-gateway" target="p1-catalog"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e5" value="Inventory routes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p1-gateway" target="p1-inventory"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e6" value="Order routes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p1-gateway" target="p1-order"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e7" value="Payment routes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p1-gateway" target="p1-payment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e8" value="Mongoose" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p1-auth" target="p1-mongo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e9" value="Mongoose" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p1-user" target="p1-mongo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e10" value="Mongoose" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p1-catalog" target="p1-mongo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e11" value="Mongoose" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p1-inventory" target="p1-mongo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e12" value="Mongoose" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p1-order" target="p1-mongo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e13" value="Mongoose" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p1-payment" target="p1-mongo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e14" value="Cache" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p1-order" target="p1-redis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e15" value="Publish events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p1-payment" target="p1-rabbit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e16" value="Consume / retry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p1-rabbit" target="p1-workers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e17" value="Provider APIs / webhooks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p1-payment" target="p1-provider"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="data-model" name="2. Data Model">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p2-title" value="MongoDB collection relationship map" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=26;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="20" width="750" height="40" as="geometry"/></mxCell>
        <mxCell id="p2-legend" value="Each collection keeps MongoDB &lt;b&gt;_id&lt;/b&gt;. Fields marked ★ are unique and immutable business identifiers. Relationships inside V1 store ObjectId references; orders/invoices also embed immutable snapshots." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=13" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1350" height="55" as="geometry"/></mxCell>

        <mxCell id="p2-identity-lane" value="IDENTITY" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="150" width="420" height="1160" as="geometry"/></mxCell>
        <mxCell id="p2-catalog-lane" value="CATALOG" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="490" y="150" width="450" height="1160" as="geometry"/></mxCell>
        <mxCell id="p2-inventory-lane" value="INVENTORY / PROCUREMENT" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="970" y="150" width="450" height="1160" as="geometry"/></mxCell>
        <mxCell id="p2-sales-lane" value="CART / ORDER" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1450" y="150" width="420" height="1160" as="geometry"/></mxCell>
        <mxCell id="p2-billing-lane" value="PAYMENT / BILLING / FULFILLMENT" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1900" y="150" width="460" height="1160" as="geometry"/></mxCell>

        <mxCell id="p2-users" value="&lt;b&gt;users&lt;/b&gt;&lt;br&gt;★ customerNumber&lt;br&gt;email (unique, mutable)&lt;br&gt;name / phone / passwordHash&lt;br&gt;roles[] / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="70" y="210" width="350" height="130" as="geometry"/></mxCell>
        <mxCell id="p2-sessions" value="&lt;b&gt;auth_sessions&lt;/b&gt;&lt;br&gt;userId → users._id&lt;br&gt;refreshTokenHash (unique)&lt;br&gt;device / IP / expiresAt&lt;br&gt;revokedAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="70" y="390" width="350" height="120" as="geometry"/></mxCell>
        <mxCell id="p2-addresses" value="&lt;b&gt;addresses&lt;/b&gt;&lt;br&gt;userId → users._id&lt;br&gt;recipient / phone&lt;br&gt;line1 / city / province / country&lt;br&gt;isDefault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="70" y="560" width="350" height="120" as="geometry"/></mxCell>
        <mxCell id="p2-idnote" value="&lt;b&gt;Identity rule&lt;/b&gt;&lt;br&gt;customerNumber never changes. Email and phone are unique login/contact fields but may be updated after verification." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="70" y="760" width="350" height="100" as="geometry"/></mxCell>

        <mxCell id="p2-categories" value="&lt;b&gt;categories&lt;/b&gt;&lt;br&gt;★ categoryCode&lt;br&gt;name / slug (unique)&lt;br&gt;parentId → categories._id&lt;br&gt;status / sortOrder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="530" y="205" width="170" height="135" as="geometry"/></mxCell>
        <mxCell id="p2-brands" value="&lt;b&gt;brands&lt;/b&gt;&lt;br&gt;★ brandCode&lt;br&gt;name / slug (unique)&lt;br&gt;logo / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="730" y="205" width="170" height="135" as="geometry"/></mxCell>
        <mxCell id="p2-products" value="&lt;b&gt;products&lt;/b&gt;&lt;br&gt;★ productCode&lt;br&gt;categoryId / brandId&lt;br&gt;name / slug / type&lt;br&gt;trackingType / status&lt;br&gt;No canonical price or stock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="545" y="410" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="p2-variants" value="&lt;b&gt;product_variants&lt;/b&gt;&lt;br&gt;★ sku&lt;br&gt;productId → products._id&lt;br&gt;optionValues / barcode&lt;br&gt;pricing snapshot source&lt;br&gt;stockSummary (derived)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="545" y="625" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="p2-reviews" value="&lt;b&gt;reviews&lt;/b&gt;&lt;br&gt;productId / userId&lt;br&gt;orderItem reference&lt;br&gt;rating / comment&lt;br&gt;verifiedPurchase / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="530" y="850" width="170" height="130" as="geometry"/></mxCell>
        <mxCell id="p2-wishlist" value="&lt;b&gt;wishlists&lt;/b&gt;&lt;br&gt;userId (unique)&lt;br&gt;items[].productId&lt;br&gt;addedAt / note" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="730" y="850" width="170" height="130" as="geometry"/></mxCell>

        <mxCell id="p2-supplier" value="&lt;b&gt;suppliers&lt;/b&gt;&lt;br&gt;★ supplierCode&lt;br&gt;name / contact&lt;br&gt;taxNumber / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1010" y="205" width="170" height="125" as="geometry"/></mxCell>
        <mxCell id="p2-location" value="&lt;b&gt;stock_locations&lt;/b&gt;&lt;br&gt;★ locationCode&lt;br&gt;name / type&lt;br&gt;address / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1210" y="205" width="170" height="125" as="geometry"/></mxCell>
        <mxCell id="p2-po" value="&lt;b&gt;purchase_orders&lt;/b&gt;&lt;br&gt;★ purchaseOrderNumber&lt;br&gt;supplierId / locationId&lt;br&gt;items: variant, qty, cost&lt;br&gt;DRAFT → RECEIVED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1025" y="390" width="340" height="140" as="geometry"/></mxCell>
        <mxCell id="p2-units" value="&lt;b&gt;inventory_units&lt;/b&gt;&lt;br&gt;★ inventoryUnitNumber&lt;br&gt;★ serial / IMEI when serialized&lt;br&gt;variantId / locationId&lt;br&gt;AVAILABLE / RESERVED / SOLD&lt;br&gt;purchase and warranty snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1000" y="595" width="195" height="165" as="geometry"/></mxCell>
        <mxCell id="p2-balances" value="&lt;b&gt;inventory_balances&lt;/b&gt;&lt;br&gt;Bulk/non-serialized stock&lt;br&gt;variantId + locationId unique&lt;br&gt;onHand / reserved / available&lt;br&gt;optimistic version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1215" y="595" width="175" height="165" as="geometry"/></mxCell>
        <mxCell id="p2-movements" value="&lt;b&gt;inventory_movements&lt;/b&gt;&lt;br&gt;Append-only audit ledger&lt;br&gt;type / qty / location&lt;br&gt;referenceType + referenceId&lt;br&gt;Never update or delete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1000" y="830" width="190" height="145" as="geometry"/></mxCell>
        <mxCell id="p2-reservation" value="&lt;b&gt;inventory_reservations&lt;/b&gt;&lt;br&gt;★ reservationNumber&lt;br&gt;orderId / userId&lt;br&gt;items / unitIds / quantity&lt;br&gt;ACTIVE → CONSUMED&lt;br&gt;or RELEASED / EXPIRED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1215" y="830" width="175" height="160" as="geometry"/></mxCell>

        <mxCell id="p2-carts" value="&lt;b&gt;carts&lt;/b&gt;&lt;br&gt;userId (unique)&lt;br&gt;items: productId, variantId, qty&lt;br&gt;couponId / deliveryId&lt;br&gt;Temporary: _id is enough" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1490" y="220" width="340" height="130" as="geometry"/></mxCell>
        <mxCell id="p2-coupons" value="&lt;b&gt;coupons&lt;/b&gt;&lt;br&gt;★ code&lt;br&gt;type / value / limits&lt;br&gt;start / expiry / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1490" y="410" width="160" height="125" as="geometry"/></mxCell>
        <mxCell id="p2-couponusage" value="&lt;b&gt;coupon_usages&lt;/b&gt;&lt;br&gt;couponId / userId / orderId&lt;br&gt;RESERVED / CONSUMED / RELEASED&lt;br&gt;couponId + orderId unique" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1670" y="410" width="160" height="125" as="geometry"/></mxCell>
        <mxCell id="p2-orders" value="&lt;b&gt;orders&lt;/b&gt;&lt;br&gt;★ orderNumber&lt;br&gt;userId / reservationId&lt;br&gt;item + price + address snapshots&lt;br&gt;orderStatus / paymentStatus&lt;br&gt;fulfillmentStatus / billingStatus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1490" y="620" width="340" height="165" as="geometry"/></mxCell>
        <mxCell id="p2-orderhistory" value="&lt;b&gt;Embedded order history&lt;/b&gt;&lt;br&gt;from / to / message&lt;br&gt;changedBy / changedAt&lt;br&gt;Orders preserve product and money facts even when catalog changes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1490" y="850" width="340" height="130" as="geometry"/></mxCell>

        <mxCell id="p2-payments" value="&lt;b&gt;payments&lt;/b&gt;&lt;br&gt;★ paymentNumber&lt;br&gt;orderId / invoiceId&lt;br&gt;idempotencyKey (unique, immutable)&lt;br&gt;providerReference / amount&lt;br&gt;PENDING → SUCCESS / FAILED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1940" y="205" width="180" height="165" as="geometry"/></mxCell>
        <mxCell id="p2-events" value="&lt;b&gt;payment_events&lt;/b&gt;&lt;br&gt;providerEventId unique&lt;br&gt;signatureVerified&lt;br&gt;payload / status&lt;br&gt;Deduplicates webhooks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2140" y="205" width="180" height="165" as="geometry"/></mxCell>
        <mxCell id="p2-invoices" value="&lt;b&gt;invoices&lt;/b&gt;&lt;br&gt;★ invoiceNumber&lt;br&gt;orderId unique + immutable&lt;br&gt;customer/item/payment snapshots&lt;br&gt;total / paid / balance&lt;br&gt;ISSUED → PAID → CLOSED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1940" y="430" width="180" height="165" as="geometry"/></mxCell>
        <mxCell id="p2-receipts" value="&lt;b&gt;receipts&lt;/b&gt;&lt;br&gt;★ receiptNumber&lt;br&gt;paymentId unique + immutable&lt;br&gt;invoiceId / amount / method&lt;br&gt;Proof of successful payment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2140" y="430" width="180" height="165" as="geometry"/></mxCell>
        <mxCell id="p2-shipment" value="&lt;b&gt;shipments&lt;/b&gt;&lt;br&gt;★ shipmentNumber&lt;br&gt;orderId / carrier&lt;br&gt;trackingNumber (unique, mutable)&lt;br&gt;PACKING → DELIVERED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1940" y="660" width="180" height="145" as="geometry"/></mxCell>
        <mxCell id="p2-returns" value="&lt;b&gt;returns&lt;/b&gt;&lt;br&gt;★ returnNumber&lt;br&gt;orderId / item lines&lt;br&gt;reason / condition&lt;br&gt;REQUESTED → COMPLETED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2140" y="660" width="180" height="145" as="geometry"/></mxCell>
        <mxCell id="p2-refunds" value="&lt;b&gt;refunds&lt;/b&gt;&lt;br&gt;★ refundNumber&lt;br&gt;returnId / paymentId / amount&lt;br&gt;provider reference&lt;br&gt;PENDING → SUCCESS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1940" y="880" width="180" height="135" as="geometry"/></mxCell>
        <mxCell id="p2-credit" value="&lt;b&gt;credit_notes&lt;/b&gt;&lt;br&gt;★ creditNoteNumber&lt;br&gt;invoiceId / refundId&lt;br&gt;Immutable financial correction&lt;br&gt;Original closed invoice stays unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2140" y="880" width="180" height="135" as="geometry"/></mxCell>

        <mxCell id="p2-e1" value="has" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="p2-users" target="p2-sessions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e2" value="has" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="p2-users" target="p2-addresses"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e3" value="classifies" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p2-categories" target="p2-products"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e4" value="brands" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p2-brands" target="p2-products"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e5" value="has variants" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="p2-products" target="p2-variants"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e6" value="supplies" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p2-supplier" target="p2-po"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e7" value="receives into" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p2-location" target="p2-po"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e8" value="creates serialized stock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p2-po" target="p2-units"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e9" value="creates bulk stock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p2-po" target="p2-balances"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e10" value="audited by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p2-units" target="p2-movements"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e11" value="reserve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p2-units" target="p2-reservation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e12" value="selected items" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p2-variants" target="p2-carts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e13" value="applies" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p2-coupons" target="p2-carts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e14" value="checkout snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p2-carts" target="p2-orders"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e15" value="references" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p2-reservation" target="p2-orders"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e16" value="pays" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="p2-orders" target="p2-payments"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e17" value="deduplicates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="p2-payments" target="p2-events"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e18" value="billed by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p2-orders" target="p2-invoices"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e19" value="receipt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p2-payments" target="p2-receipts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e20" value="fulfilled by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p2-orders" target="p2-shipment"><mxGeometry relative="1" as="geometry"/></mxCell>
