  </diagram>

  <diagram id="inventory-flow" name="3. Stock In to Available">
    <mxGraphModel dx="1900" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p3-title" value="Admin and inventory flow — master data to sellable stock" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=26;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="p3-adminlane" value="ADMIN / STAFF" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="90" width="2000" height="210" as="geometry"/></mxCell>
        <mxCell id="p3-cataloglane" value="CATALOG SERVICE" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="330" width="2000" height="210" as="geometry"/></mxCell>
        <mxCell id="p3-invlane" value="INVENTORY SERVICE / MONGODB TRANSACTION" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="570" width="2000" height="420" as="geometry"/></mxCell>
        <mxCell id="p3-eventlane" value="EVENTS / READ MODELS" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="2000" height="150" as="geometry"/></mxCell>

        <mxCell id="p3-a1" value="1. Create supplier&lt;br&gt;★ supplierCode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="90" y="160" width="180" height="75" as="geometry"/></mxCell>
        <mxCell id="p3-a2" value="2. Create warehouse/store&lt;br&gt;★ locationCode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="320" y="160" width="190" height="75" as="geometry"/></mxCell>
        <mxCell id="p3-a3" value="3. Create category + brand&lt;br&gt;immutable codes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="560" y="160" width="200" height="75" as="geometry"/></mxCell>
        <mxCell id="p3-a4" value="4. Create product&lt;br&gt;★ productCode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="810" y="160" width="180" height="75" as="geometry"/></mxCell>
        <mxCell id="p3-a5" value="5. Create variants&lt;br&gt;★ SKU + price" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1040" y="160" width="180" height="75" as="geometry"/></mxCell>
        <mxCell id="p3-a6" value="6. Create purchase order&lt;br&gt;★ PO number" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1270" y="160" width="190" height="75" as="geometry"/></mxCell>
        <mxCell id="p3-a7" value="7. Receive shipment&lt;br&gt;count + inspect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1510" y="160" width="180" height="75" as="geometry"/></mxCell>
        <mxCell id="p3-a8" value="8. Submit stock-in&lt;br&gt;cost / identifiers / location" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1740" y="150" width="220" height="95" as="geometry"/></mxCell>

        <mxCell id="p3-c1" value="Product master&lt;br&gt;name / type / trackingType&lt;br&gt;category / brand / media" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="720" y="390" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="p3-c2" value="Variant master&lt;br&gt;SKU / barcode / options&lt;br&gt;sale price / currency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="1050" y="390" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="p3-c3" value="Catalog is descriptive.&lt;br&gt;Inventory owns availability.&lt;br&gt;Variant stockSummary is a derived read model." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10" vertex="1" parent="1"><mxGeometry x="1430" y="385" width="350" height="105" as="geometry"/></mxCell>

        <mxCell id="p3-check" value="Tracking type?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="230" y="680" width="170" height="105" as="geometry"/></mxCell>
        <mxCell id="p3-serial" value="SERIAL&lt;br&gt;Validate serial/IMEI uniqueness&lt;br&gt;Create one inventory_unit per device&lt;br&gt;status = AVAILABLE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="500" y="625" width="290" height="125" as="geometry"/></mxCell>
        <mxCell id="p3-bulk" value="BATCH / NONE&lt;br&gt;Atomic increment inventory_balance&lt;br&gt;variantId + locationId unique&lt;br&gt;available = onHand − reserved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="500" y="790" width="290" height="125" as="geometry"/></mxCell>
        <mxCell id="p3-move" value="Create append-only movement&lt;br&gt;type = STOCK_IN&lt;br&gt;referenceType = PURCHASE_ORDER&lt;br&gt;referenceId = PO _id&lt;br&gt;quantity / unit / location / actor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="900" y="690" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="p3-recalc" value="Recalculate variant stock summary&lt;br&gt;onHand = AVAILABLE + RESERVED + SOLD...&lt;br&gt;available = sellable units − safety stock&lt;br&gt;Use transaction / optimistic concurrency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1320" y="690" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="p3-ready" value="Stock is sellable&lt;br&gt;Product remains ACTIVE&lt;br&gt;Variant remains ACTIVE&lt;br&gt;Location remains ACTIVE&lt;br&gt;available &gt; safetyStock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1740" y="695" width="240" height="140" as="geometry"/></mxCell>
        <mxCell id="p3-controls" value="Inventory operations after stock-in&lt;br&gt;TRANSFER: location A → location B&lt;br&gt;ADJUST: audited correction only&lt;br&gt;DAMAGED / REPAIR / LOST: remove from available&lt;br&gt;RETURNED: inspect, then AVAILABLE or DAMAGED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10" vertex="1" parent="1"><mxGeometry x="900" y="875" width="740" height="90" as="geometry"/></mxCell>

        <mxCell id="p3-event1" value="Publish inventory.stocked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="980" y="1070" width="240" height="55" as="geometry"/></mxCell>
        <mxCell id="p3-event2" value="Catalog updates stockSummary read model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="1320" y="1070" width="290" height="55" as="geometry"/></mxCell>
        <mxCell id="p3-event3" value="Admin activity log / notification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="1710" y="1070" width="260" height="55" as="geometry"/></mxCell>

        <mxCell id="p3-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p3-a1" target="p3-a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p3-a2" target="p3-a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p3-a3" target="p3-a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p3-a4" target="p3-a5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p3-a5" target="p3-a6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p3-a6" target="p3-a7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p3-a7" target="p3-a8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e8" value="trackingType" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p3-c1" target="p3-check"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e9" value="SERIAL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p3-check" target="p3-serial"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e10" value="BATCH / NONE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p3-check" target="p3-bulk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p3-serial" target="p3-move"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p3-bulk" target="p3-move"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p3-move" target="p3-recalc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p3-recalc" target="p3-ready"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p3-recalc" target="p3-event1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p3-event1" target="p3-event2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p3-event2" target="p3-event3"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="checkout-billing" name="4. Checkout to Close Bill">
    <mxGraphModel dx="2100" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p4-title" value="Customer checkout → payment → fulfillment → closed bill" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=26;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell>
        <mxCell id="p4-guard" value="Critical invariant: reserve inventory before starting payment. A payment webhook must be idempotent. Never clear the cart or consume the coupon permanently until the order is safely created and payment policy allows it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=13" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1540" height="55" as="geometry"/></mxCell>

        <mxCell id="p4-clientlane" value="CLIENT" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="150" width="280" height="1450" as="geometry"/></mxCell>
        <mxCell id="p4-orderlane" value="ORDER SERVICE" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1"><mxGeometry x="340" y="150" width="390" height="1450" as="geometry"/></mxCell>
        <mxCell id="p4-cataloglane" value="CATALOG SERVICE" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="750" y="150" width="280" height="1450" as="geometry"/></mxCell>
        <mxCell id="p4-invlane" value="INVENTORY SERVICE" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1050" y="150" width="320" height="1450" as="geometry"/></mxCell>
        <mxCell id="p4-paylane" value="PAYMENT / PROVIDER" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1390" y="150" width="340" height="1450" as="geometry"/></mxCell>
        <mxCell id="p4-billlane" value="FULFILLMENT / BILLING" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1750" y="150" width="490" height="1450" as="geometry"/></mxCell>

        <mxCell id="p4-c1" value="1. Browse active products&lt;br&gt;Select SKU and quantity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666" vertex="1" parent="1"><mxGeometry x="75" y="210" width="210" height="75" as="geometry"/></mxCell>
        <mxCell id="p4-o1" value="2. Add to cart&lt;br&gt;Store productId + variantId + quantity&lt;br&gt;Do not trust frontend price" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450" vertex="1" parent="1"><mxGeometry x="390" y="310" width="290" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-c2" value="3. Choose address, coupon,&lt;br&gt;delivery and payment method" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666" vertex="1" parent="1"><mxGeometry x="75" y="430" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="p4-o2" value="4. POST /checkout&lt;br&gt;Load cart + coupon usage&lt;br&gt;Normalize address / delivery&lt;br&gt;Generate idempotency key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450" vertex="1" parent="1"><mxGeometry x="390" y="540" width="290" height="105" as="geometry"/></mxCell>
        <mxCell id="p4-cat1" value="5. Validate catalog&lt;br&gt;product ACTIVE&lt;br&gt;variant ACTIVE&lt;br&gt;server price + currency&lt;br&gt;return immutable item snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="785" y="680" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="p4-inv1" value="6. Reserve stock atomically&lt;br&gt;Serialized: pick AVAILABLE unit IDs&lt;br&gt;Bulk: increment reserved if available&lt;br&gt;expiresAt = now + 15 minutes&lt;br&gt;create RESERVED movement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="1085" y="825" width="250" height="145" as="geometry"/></mxCell>
        <mxCell id="p4-stockok" value="Enough stock?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1130" y="1010" width="160" height="95" as="geometry"/></mxCell>
        <mxCell id="p4-o3" value="7. Create order snapshot&lt;br&gt;★ orderNumber&lt;br&gt;PENDING_PAYMENT / UNPAID&lt;br&gt;Save reservationId&lt;br&gt;Reserve coupon usage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450" vertex="1" parent="1"><mxGeometry x="390" y="990" width="290" height="125" as="geometry"/></mxCell>
        <mxCell id="p4-pay1" value="8. Create payment intent&lt;br&gt;★ paymentNumber&lt;br&gt;unique idempotencyKey&lt;br&gt;amount must equal order total&lt;br&gt;status = PENDING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="1435" y="1020" width="250" height="125" as="geometry"/></mxCell>
        <mxCell id="p4-response" value="9. Return orderNumber + payment checkout data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666" vertex="1" parent="1"><mxGeometry x="75" y="1165" width="210" height="75" as="geometry"/></mxCell>

        <mxCell id="p4-webhook" value="10. Provider webhook&lt;br&gt;Verify signature&lt;br&gt;Insert providerEventId unique&lt;br&gt;Duplicate event = return 2xx without reprocessing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="1435" y="1190" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="p4-payok" value="Payment success?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1480" y="1360" width="160" height="95" as="geometry"/></mxCell>

        <mxCell id="p4-success" value="SUCCESS transaction / saga&lt;br&gt;Payment → SUCCESS&lt;br&gt;Reservation → CONSUMED&lt;br&gt;Inventory → SOLD + movement&lt;br&gt;Coupon usage → CONSUMED&lt;br&gt;Order → CONFIRMED + PAID&lt;br&gt;Clear cart and publish payment.completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1045" y="1450" width="330" height="150" as="geometry"/></mxCell>
        <mxCell id="p4-failure" value="FAILURE / timeout compensation&lt;br&gt;Payment → FAILED / CANCELLED&lt;br&gt;Reservation → RELEASED&lt;br&gt;Inventory → AVAILABLE + release movement&lt;br&gt;Coupon usage → RELEASED&lt;br&gt;Order → CANCELLED / FAILED&lt;br&gt;Keep or restore cart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1400" y="1450" width="330" height="150" as="geometry"/></mxCell>

        <mxCell id="p4-invoice" value="11. Issue invoice&lt;br&gt;★ invoiceNumber&lt;br&gt;Copy customer, items, tax and totals&lt;br&gt;Allocate successful payment&lt;br&gt;balanceDue = total − paid&lt;br&gt;PAID when balance is zero" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="1795" y="230" width="390" height="135" as="geometry"/></mxCell>
        <mxCell id="p4-receipt" value="12. Create receipt&lt;br&gt;★ receiptNumber&lt;br&gt;paymentId unique and immutable&lt;br&gt;Proof of payment; never overwrite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="1795" y="410" width="390" height="110" as="geometry"/></mxCell>
        <mxCell id="p4-pack" value="13. Fulfillment&lt;br&gt;CONFIRMED → PROCESSING&lt;br&gt;Pick exact serialized units&lt;br&gt;Pack and create shipmentNumber" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="1795" y="570" width="390" height="110" as="geometry"/></mxCell>
        <mxCell id="p4-ship" value="14. Ship and deliver&lt;br&gt;PACKING → SHIPPED → IN_TRANSIT → DELIVERED&lt;br&gt;Store tracking events and deliveredAt&lt;br&gt;For COD: payment succeeds on collection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="1795" y="730" width="390" height="120" as="geometry"/></mxCell>
        <mxCell id="p4-closecheck" value="Close-bill conditions met?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1885" y="910" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="p4-conditions" value="Required&lt;br&gt;Invoice balanceDue = 0&lt;br&gt;Payment SUCCESS&lt;br&gt;Shipment DELIVERED or approved override&lt;br&gt;No pending refund&lt;br&gt;Inventory SOLD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1795" y="1060" width="185" height="145" as="geometry"/></mxCell>
        <mxCell id="p4-closed" value="15. Close bill atomically&lt;br&gt;Invoice → CLOSED&lt;br&gt;Order.billingStatus → CLOSED&lt;br&gt;Order.orderStatus → COMPLETED&lt;br&gt;Set closedAt + closedBy&lt;br&gt;Write immutable audit event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="2000" y="1060" width="185" height="145" as="geometry"/></mxCell>
        <mxCell id="p4-after" value="After CLOSED&lt;br&gt;Do not edit invoice number, customer, items, tax or totals.&lt;br&gt;Return/refund creates a refund and credit note; the original invoice remains unchanged." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1795" y="1260" width="390" height="125" as="geometry"/></mxCell>

        <mxCell id="p4-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p4-c1" target="p4-o1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p4-o1" target="p4-c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p4-c2" target="p4-o2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e4" value="HTTP contract" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p4-o2" target="p4-cat1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e5" value="validated snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p4-cat1" target="p4-inv1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p4-inv1" target="p4-stockok"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e7" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p4-stockok" target="p4-o3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e8" value="NO: 409 out of stock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450" edge="1" parent="1" source="p4-stockok" target="p4-c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e9" value="createForOrder" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p4-o3" target="p4-pay1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e10" value="checkout data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p4-pay1" target="p4-response"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e11" value="async callback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p4-response" target="p4-webhook"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p4-webhook" target="p4-payok"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e13" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366" edge="1" parent="1" source="p4-payok" target="p4-success"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e14" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450" edge="1" parent="1" source="p4-payok" target="p4-failure"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e15" value="payment.completed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p4-success" target="p4-invoice"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p4-invoice" target="p4-receipt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p4-receipt" target="p4-pack"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p4-pack" target="p4-ship"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p4-ship" target="p4-closecheck"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e20" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366" edge="1" parent="1" source="p4-closecheck" target="p4-closed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e21" value="NO: remain OPEN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d6b656" edge="1" parent="1" source="p4-closecheck" target="p4-conditions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p4-closed" target="p4-after"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="states-identifiers" name="5. States and IDs">
    <mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p5-title" value="State machines, identifier rules, and operational safeguards" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=26;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell>

        <mxCell id="p5-ordergroup" value="ORDER LIFECYCLE" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1980" height="210" as="geometry"/></mxCell>
        <mxCell id="p5-opending" value="PENDING_PAYMENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="100" y="185" width="190" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-confirm" value="CONFIRMED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="430" y="185" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-process" value="PROCESSING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="730" y="185" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-shipped" value="SHIPPED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1030" y="185" width="150" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-delivered" value="DELIVERED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1320" y="185" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-completed" value="COMPLETED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1620" y="185" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-cancel" value="CANCELLED / FAILED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1"><mxGeometry x="860" y="250" width="200" height="45" as="geometry"/></mxCell>

        <mxCell id="p5-paymentgroup" value="PAYMENT LIFECYCLE" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1980" height="190" as="geometry"/></mxCell>
        <mxCell id="p5-ppending" value="PENDING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="120" y="420" width="150" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-authorized" value="AUTHORIZED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="420" y="420" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-psuccess" value="SUCCESS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="730" y="420" width="150" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-partrefund" value="PARTIALLY_REFUNDED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1040" y="420" width="210" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-refunded" value="REFUNDED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1410" y="420" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-pfailed" value="FAILED / CANCELLED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1650" y="420" width="210" height="55" as="geometry"/></mxCell>

        <mxCell id="p5-invgroup" value="INVENTORY UNIT LIFECYCLE" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1980" height="200" as="geometry"/></mxCell>
        <mxCell id="p5-avail" value="AVAILABLE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="150" y="645" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-reserved" value="RESERVED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="500" y="645" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-sold" value="SOLD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="850" y="645" width="150" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-returned" value="RETURNED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1190" y="645" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-damaged" value="DAMAGED / REPAIR / LOST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1540" y="645" width="250" height="55" as="geometry"/></mxCell>

        <mxCell id="p5-billgroup" value="INVOICE / BILL LIFECYCLE" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1980" height="200" as="geometry"/></mxCell>
        <mxCell id="p5-draft" value="DRAFT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1" vertex="1" parent="1"><mxGeometry x="130" y="875" width="140" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-issued" value="ISSUED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="410" y="875" width="140" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-partpaid" value="PARTIALLY_PAID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="690" y="875" width="190" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-paid" value="PAID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1030" y="875" width="140" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-closed" value="CLOSED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1320" y="875" width="150" height="55" as="geometry"/></mxCell>
        <mxCell id="p5-void" value="VOID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1630" y="875" width="140" height="55" as="geometry"/></mxCell>

        <mxCell id="p5-idrules" value="&lt;b&gt;Identifier rules&lt;/b&gt;&lt;br&gt;1. Keep MongoDB _id for internal same-database references.&lt;br&gt;2. Business identifiers are unique, immutable, uppercase, trimmed, and generated once.&lt;br&gt;3. Examples: productCode, SKU, orderNumber, paymentNumber, invoiceNumber, receiptNumber.&lt;br&gt;4. Do not duplicate _id into id/orderId fields that mean the same document.&lt;br&gt;5. Email and phone can be unique but remain mutable.&lt;br&gt;6. Tracking number may change; shipmentNumber does not.&lt;br&gt;7. Catch MongoDB E11000; unique is a database index, not a validator." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontSize=13" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="930" height="220" as="geometry"/></mxCell>
        <mxCell id="p5-ops" value="&lt;b&gt;Production safeguards&lt;/b&gt;&lt;br&gt;• Transaction or saga compensation for checkout&lt;br&gt;• Optimistic concurrency for stock, order, payment and invoice&lt;br&gt;• Idempotency key for checkout/payment creation&lt;br&gt;• Unique providerEventId for webhook deduplication&lt;br&gt;• Outbox/inbox records for reliable RabbitMQ publishing&lt;br&gt;• Append-only inventory and financial audit logs&lt;br&gt;• Reservation expiry worker and payment reconciliation worker&lt;br&gt;• Closed invoices are immutable; corrections use credit notes&lt;br&gt;• Concurrent “last item” test must allow exactly one buyer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12;fontSize=13" vertex="1" parent="1"><mxGeometry x="1010" y="1040" width="1010" height="220" as="geometry"/></mxCell>

        <mxCell id="p5-e1" value="payment success" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p5-opending" target="p5-confirm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e2" value="staff accepts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p5-confirm" target="p5-process"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e3" value="carrier pickup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p5-process" target="p5-shipped"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e4" value="proof of delivery" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p5-shipped" target="p5-delivered"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e5" value="bill closed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p5-delivered" target="p5-completed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e6" value="cancel / timeout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450" edge="1" parent="1" source="p5-opending" target="p5-cancel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e7" value="capture" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p5-ppending" target="p5-authorized"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e8" value="confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p5-authorized" target="p5-psuccess"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e9" value="partial refund" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p5-psuccess" target="p5-partrefund"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e10" value="remaining refund" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p5-partrefund" target="p5-refunded"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e11" value="provider failure" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450" edge="1" parent="1" source="p5-ppending" target="p5-pfailed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e12" value="checkout reserve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p5-avail" target="p5-reserved"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e13" value="payment success" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p5-reserved" target="p5-sold"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e14" value="return received" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p5-sold" target="p5-returned"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e15" value="inspection" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p5-returned" target="p5-damaged"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e16" value="sellable return" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p5-returned" target="p5-avail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e17" value="issue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p5-draft" target="p5-issued"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e18" value="some allocation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p5-issued" target="p5-partpaid"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e19" value="balance = 0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p5-partpaid" target="p5-paid"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e20" value="delivered + verified" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="p5-paid" target="p5-closed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e21" value="void before close" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450" edge="1" parent="1" source="p5-issued" target="p5-void"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="all-current-relationships" name="6. All Current Collections">
    <mxGraphModel dx="2800" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="2100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p6-title" value="All current MongoDB collections and relationships in this repository" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=26;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="p6-note" value="This page reflects the Mongoose models currently implemented in the code. Solid arrows are stored ObjectId refs. Dashed arrows are logical/string or embedded-item relationships. Red indicates a referenced model that is currently missing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=13" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1780" height="55" as="geometry"/></mxCell>
        <mxCell id="p6-legend1" value="Stored ObjectId ref" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="1880" y="70" width="170" height="45" as="geometry"/></mxCell>
        <mxCell id="p6-legend2" value="Logical / embedded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1" vertex="1" parent="1"><mxGeometry x="2070" y="70" width="170" height="45" as="geometry"/></mxCell>
        <mxCell id="p6-legend3" value="Missing target model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1" vertex="1" parent="1"><mxGeometry x="2260" y="70" width="180" height="45" as="geometry"/></mxCell>

        <mxCell id="p6-identity" value="AUTH / USER" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="155" width="520" height="710" as="geometry"/></mxCell>
        <mxCell id="p6-catalog" value="CATALOG" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="590" y="155" width="940" height="1270" as="geometry"/></mxCell>
        <mxCell id="p6-inventory" value="INVENTORY" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1560" y="155" width="760" height="1270" as="geometry"/></mxCell>
        <mxCell id="p6-sales" value="ORDER / PROMOTION" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1"><mxGeometry x="2350" y="155" width="760" height="1270" as="geometry"/></mxCell>
        <mxCell id="p6-relations" value="COMPLETE RELATIONSHIP CATALOG" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="1460" width="3070" height="560" as="geometry"/></mxCell>

        <mxCell id="p6-users" value="&lt;b&gt;users&lt;/b&gt; (User)&lt;br&gt;PK _id&lt;br&gt;name / email / password&lt;br&gt;role: String enum&lt;br&gt;status / limit&lt;br&gt;&lt;i&gt;Referenced by 9 collections&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=13" vertex="1" parent="1"><mxGeometry x="90" y="235" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="p6-roles" value="&lt;b&gt;roles&lt;/b&gt; (Role)&lt;br&gt;PK _id&lt;br&gt;name unique&lt;br&gt;permission[]&lt;br&gt;&lt;i&gt;User.role is a string, not an ObjectId ref&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=13" vertex="1" parent="1"><mxGeometry x="330" y="235" width="190" height="150" as="geometry"/></mxCell>
        <mxCell id="p6-authgap" value="&lt;b&gt;Recommended missing identity collections&lt;/b&gt;&lt;br&gt;auth_sessions → users._id&lt;br&gt;addresses → users._id&lt;br&gt;These appear on target Data Model page 2." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="90" y="480" width="430" height="115" as="geometry"/></mxCell>
        <mxCell id="p6-userrules" value="&lt;b&gt;Current user references&lt;/b&gt;&lt;br&gt;Product.seller / createdBy&lt;br&gt;Review.user&lt;br&gt;Wishlist.user&lt;br&gt;Cart.user&lt;br&gt;PromoUsage.user&lt;br&gt;Order.user&lt;br&gt;Payment.user&lt;br&gt;InventoryUnit.reservedBy&lt;br&gt;InventoryMovement.createdBy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="90" y="630" width="430" height="190" as="geometry"/></mxCell>

        <mxCell id="p6-brands" value="&lt;b&gt;brands&lt;/b&gt; (Brand)&lt;br&gt;PK _id&lt;br&gt;name unique / slug unique&lt;br&gt;isActive&lt;br&gt;virtual productCount" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="630" y="225" width="190" height="130" as="geometry"/></mxCell>
        <mxCell id="p6-categories" value="&lt;b&gt;categories&lt;/b&gt; (Category)&lt;br&gt;PK _id&lt;br&gt;categoryId unique&lt;br&gt;categoryName unique&lt;br&gt;aggregate counters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="850" y="225" width="190" height="130" as="geometry"/></mxCell>
        <mxCell id="p6-products" value="&lt;b&gt;products&lt;/b&gt; (Product)&lt;br&gt;PK _id&lt;br&gt;productId / productCode&lt;br&gt;brand + brandId → Brand&lt;br&gt;category + categoryId → Category&lt;br&gt;seller + createdBy → User&lt;br&gt;productCollectionId → missing model&lt;br&gt;legacy embedded variants + stock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=13" vertex="1" parent="1"><mxGeometry x="1080" y="215" width="270" height="190" as="geometry"/></mxCell>
        <mxCell id="p6-productcollection" value="&lt;b&gt;productcollections&lt;/b&gt;&lt;br&gt;Referenced by Product.productCollectionId&lt;br&gt;&lt;b&gt;No Mongoose model currently exists&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1370" y="225" width="130" height="160" as="geometry"/></mxCell>
        <mxCell id="p6-variants" value="&lt;b&gt;productvariants&lt;/b&gt; (ProductVariant)&lt;br&gt;PK _id&lt;br&gt;productId → Product&lt;br&gt;sku unique / barcode&lt;br&gt;pricing / stockSummary&lt;br&gt;images / isActive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="630" y="485" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="p6-reviews" value="&lt;b&gt;reviews&lt;/b&gt; (Review)&lt;br&gt;PK _id&lt;br&gt;product → Product&lt;br&gt;user → User&lt;br&gt;orderItem: ObjectId, no ref&lt;br&gt;product + user unique" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="890" y="485" width="210" height="150" as="geometry"/></mxCell>
        <mxCell id="p6-wishlist" value="&lt;b&gt;wishlists&lt;/b&gt; (Wishlist)&lt;br&gt;PK _id&lt;br&gt;user → User, unique&lt;br&gt;items[].product → Product&lt;br&gt;addedAt / note" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1130" y="485" width="210" height="150" as="geometry"/></mxCell>
        <mxCell id="p6-sidebar" value="&lt;b&gt;sidebaritems&lt;/b&gt; (SidebarItem)&lt;br&gt;PK _id&lt;br&gt;parentId → SidebarItem._id&lt;br&gt;name / path / icon / order&lt;br&gt;Self-referencing tree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="630" y="720" width="230" height="145" as="geometry"/></mxCell>
        <mxCell id="p6-catalognote" value="&lt;b&gt;Catalog relationship issue&lt;/b&gt;&lt;br&gt;Product contains legacy embedded variants and stock while ProductVariant also owns variants and stockSummary. Choose ProductVariant as the canonical SKU/price source and Inventory as canonical stock." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="890" y="720" width="570" height="125" as="geometry"/></mxCell>
        <mxCell id="p6-reviewnote" value="Review.orderItem currently cannot populate an order item because order items are embedded and use {_id:false}. Use {orderId, lineNumber} or a stable orderItemId instead." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="630" y="920" width="830" height="85" as="geometry"/></mxCell>

        <mxCell id="p6-locations" value="&lt;b&gt;stocklocations&lt;/b&gt; (StockLocation)&lt;br&gt;PK _id&lt;br&gt;code unique&lt;br&gt;type / address / isActive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1600" y="225" width="200" height="125" as="geometry"/></mxCell>
        <mxCell id="p6-suppliers" value="&lt;b&gt;suppliers&lt;/b&gt; (Supplier)&lt;br&gt;PK _id&lt;br&gt;name / phone / email&lt;br&gt;contact / isActive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1830" y="225" width="200" height="125" as="geometry"/></mxCell>
        <mxCell id="p6-delivery" value="&lt;b&gt;deliverysettings&lt;/b&gt; (DeliverySetting)&lt;br&gt;PK _id&lt;br&gt;method unique&lt;br&gt;code unique&lt;br&gt;baseFee / threshold / days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2060" y="225" width="220" height="125" as="geometry"/></mxCell>
        <mxCell id="p6-units" value="&lt;b&gt;inventoryunits&lt;/b&gt; (InventoryUnit)&lt;br&gt;PK _id&lt;br&gt;productId → Product&lt;br&gt;variantId → ProductVariant&lt;br&gt;locationId → StockLocation&lt;br&gt;purchase.supplierId → Supplier&lt;br&gt;reservedBy → User&lt;br&gt;serial / IMEI / status / sold snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=13" vertex="1" parent="1"><mxGeometry x="1600" y="450" width="300" height="200" as="geometry"/></mxCell>
        <mxCell id="p6-movements" value="&lt;b&gt;inventorymovements&lt;/b&gt; (InventoryMovement)&lt;br&gt;PK _id&lt;br&gt;productId → Product&lt;br&gt;variantId → ProductVariant&lt;br&gt;inventoryUnitId → InventoryUnit&lt;br&gt;from/toLocationId → StockLocation&lt;br&gt;createdBy → User&lt;br&gt;referenceId: Mixed logical link" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=13" vertex="1" parent="1"><mxGeometry x="1940" y="450" width="320" height="200" as="geometry"/></mxCell>
        <mxCell id="p6-invgap" value="&lt;b&gt;Recommended missing inventory collections&lt;/b&gt;&lt;br&gt;purchaseorders → supplier + location + variants&lt;br&gt;inventorybalances → variant + location&lt;br&gt;inventoryreservations → order + user + units&lt;br&gt;Required for safe bulk stock and checkout reservations." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1600" y="745" width="660" height="125" as="geometry"/></mxCell>
        <mxCell id="p6-invnote" value="InventoryMovement.referenceId is Schema.Types.Mixed, so PURCHASE_ORDER / ORDER / RETURN relationships are logical and cannot be populated safely without referenceType-aware code." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1600" y="930" width="660" height="90" as="geometry"/></mxCell>

        <mxCell id="p6-carts" value="&lt;b&gt;carts&lt;/b&gt; (Cart)&lt;br&gt;PK _id&lt;br&gt;user → User, unique&lt;br&gt;items[].product → Product&lt;br&gt;promoCode → PromoCode&lt;br&gt;delivery → DeliverySetting&lt;br&gt;totals cached in document" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=13" vertex="1" parent="1"><mxGeometry x="2390" y="220" width="240" height="175" as="geometry"/></mxCell>
        <mxCell id="p6-promos" value="&lt;b&gt;promocodes&lt;/b&gt; (PromoCode)&lt;br&gt;PK _id&lt;br&gt;code unique&lt;br&gt;discount type/value&lt;br&gt;expiry / active / per-user limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2660" y="220" width="200" height="145" as="geometry"/></mxCell>
        <mxCell id="p6-promousage" value="&lt;b&gt;promousages&lt;/b&gt; (PromoUsage)&lt;br&gt;PK _id&lt;br&gt;user → User&lt;br&gt;promoCode → PromoCode&lt;br&gt;usageCount&lt;br&gt;&lt;i&gt;Missing compound unique index&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2890" y="220" width="180" height="145" as="geometry"/></mxCell>
        <mxCell id="p6-orders" value="&lt;b&gt;orders&lt;/b&gt; (Order)&lt;br&gt;PK _id — no orderNumber currently&lt;br&gt;user → User&lt;br&gt;items[].product/productId → Product&lt;br&gt;items[].variantId → ProductVariant&lt;br&gt;items[].inventoryUnitIds → InventoryUnit&lt;br&gt;delivery.setting → DeliverySetting&lt;br&gt;promoCode → PromoCode&lt;br&gt;embedded item/address/payment/summary/history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=13" vertex="1" parent="1"><mxGeometry x="2390" y="490" width="350" height="230" as="geometry"/></mxCell>
        <mxCell id="p6-payments" value="&lt;b&gt;payments&lt;/b&gt; (Payment)&lt;br&gt;PK _id&lt;br&gt;order → Order&lt;br&gt;user → User&lt;br&gt;transactionId unique&lt;br&gt;method / provider / amount / status&lt;br&gt;gateway data / verification timestamps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8;fontSize=13" vertex="1" parent="1"><mxGeometry x="2790" y="490" width="280" height="180" as="geometry"/></mxCell>
        <mxCell id="p6-salesgap" value="&lt;b&gt;Recommended missing billing/fulfillment collections&lt;/b&gt;&lt;br&gt;paymentevents → payments&lt;br&gt;invoices → orders + payment allocations&lt;br&gt;receipts → invoices + payments&lt;br&gt;shipments → orders&lt;br&gt;returns → orders&lt;br&gt;refunds → payments + returns&lt;br&gt;creditnotes → invoices + refunds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2390" y="805" width="680" height="165" as="geometry"/></mxCell>
        <mxCell id="p6-ordergap" value="&lt;b&gt;Checkout gap&lt;/b&gt;&lt;br&gt;Order and Payment currently call Inventory/Catalog models directly. Before using separate service databases, replace these imports with HTTP/event contracts and add reservation compensation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2390" y="1030" width="680" height="105" as="geometry"/></mxCell>

        <mxCell id="p6-list1" value="&lt;b&gt;Identity and ownership&lt;/b&gt;&lt;br&gt;1. User 1 — 0..1 Cart via Cart.user&lt;br&gt;2. User 1 — 0..1 Wishlist via Wishlist.user&lt;br&gt;3. User 1 — * Review via Review.user&lt;br&gt;4. User 1 — * Order via Order.user&lt;br&gt;5. User 1 — * Payment via Payment.user&lt;br&gt;6. User 1 — * PromoUsage via PromoUsage.user&lt;br&gt;7. User 1 — * Product via seller / createdBy&lt;br&gt;8. User 1 — * InventoryMovement via createdBy&lt;br&gt;9. Role ↔ User is currently a logical string match, not a ref" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=10;fontSize=13" vertex="1" parent="1"><mxGeometry x="80" y="1525" width="680" height="420" as="geometry"/></mxCell>
        <mxCell id="p6-list2" value="&lt;b&gt;Catalog and inventory&lt;/b&gt;&lt;br&gt;10. Brand 1 — * Product via brand / brandId&lt;br&gt;11. Category 1 — * Product via category / categoryId&lt;br&gt;12. Product 1 — * ProductVariant via productId&lt;br&gt;13. Product 1 — * Review via product&lt;br&gt;14. Product * — * Wishlist through Wishlist.items&lt;br&gt;15. Product * — * Cart through Cart.items&lt;br&gt;16. Product 1 — * InventoryUnit via productId&lt;br&gt;17. Variant 1 — * InventoryUnit via variantId&lt;br&gt;18. Location 1 — * InventoryUnit via locationId&lt;br&gt;19. Supplier 1 — * InventoryUnit via purchase.supplierId&lt;br&gt;20. InventoryUnit 1 — * InventoryMovement via inventoryUnitId&lt;br&gt;21. SidebarItem 1 — * SidebarItem via parentId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=10;fontSize=13" vertex="1" parent="1"><mxGeometry x="790" y="1525" width="700" height="420" as="geometry"/></mxCell>
        <mxCell id="p6-list3" value="&lt;b&gt;Sales, delivery and payment&lt;/b&gt;&lt;br&gt;22. PromoCode 1 — * PromoUsage via promoCode&lt;br&gt;23. PromoCode 1 — * Cart via promoCode&lt;br&gt;24. PromoCode 1 — * Order via promoCode&lt;br&gt;25. DeliverySetting 1 — * Cart via delivery&lt;br&gt;26. DeliverySetting 1 — * Order via delivery.setting&lt;br&gt;27. Order 1 — * embedded items&lt;br&gt;28. Order item * — 1 Product via product/productId&lt;br&gt;29. Order item * — 0..1 Variant via variantId&lt;br&gt;30. Order item * — * InventoryUnit via inventoryUnitIds&lt;br&gt;31. Order 1 — * Payment via Payment.order&lt;br&gt;32. Review.orderItem is unresolved: embedded order items have no model/ref&lt;br&gt;33. Product.productCollectionId targets a missing ProductCollection model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=10;fontSize=13" vertex="1" parent="1"><mxGeometry x="1520" y="1525" width="760" height="420" as="geometry"/></mxCell>
        <mxCell id="p6-list4" value="&lt;b&gt;Target additions required to close a bill&lt;/b&gt;&lt;br&gt;34. Order 1 — 1 InventoryReservation&lt;br&gt;35. Order 1 — 1 Invoice&lt;br&gt;36. Order 1 — * Shipment&lt;br&gt;37. Payment 1 — * PaymentEvent&lt;br&gt;38. Invoice 1 — * Receipt/payment allocation&lt;br&gt;39. Order 1 — * Return&lt;br&gt;40. Return 1 — * Refund&lt;br&gt;41. Payment 1 — * Refund&lt;br&gt;42. Closed Invoice 1 — * CreditNote&lt;br&gt;&lt;br&gt;These are target collections shown on page 2; they are not implemented yet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=10;fontSize=13" vertex="1" parent="1"><mxGeometry x="2310" y="1525" width="750" height="420" as="geometry"/></mxCell>

        <mxCell id="p6-e1" value="role string" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#666666" edge="1" parent="1" source="p6-users" target="p6-roles"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p6-e2" value="brand / brandId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf" edge="1" parent="1" source="p6-products" target="p6-brands"><mxGeometry relative="1" as="geometry"/></mxCell>
