NODE_ENV=development
PORT=5002
MONGO_URI=mongodb://localhost:27017/rest-api-node
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=replace-with-access-token-secret
JWT_REFRESH_SECRET=replace-with-refresh-token-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Optional service-to-service fallback for protected endpoints.
API_KEY=replace-with-service-api-key
API_KEY_USER_ID=service-account
API_KEY_ROLE=ADMIN

# Optional infrastructure.
REDIS_URL=redis://localhost:6379
PROXY_TARGET=

# ABA PayWay / KHQR payment config.
PAYWAY_ENABLED=true
PAYWAY_ENV=sandbox
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_MERCHANT_ID=your-payway-merchant-id
PAYWAY_API_KEY=your-payway-api-key
PAYWAY_CALLBACK_URL=https://your-domain.com/api/v1/payments/webhook/payway
PAYWAY_RETURN_URL=https://your-frontend.com/payment/success
PAYWAY_CANCEL_URL=https://your-frontend.com/payment/cancel
PAYWAY_QR_IMAGE_TEMPLATE=template3_color
PAYWAY_QR_LIFETIME=6

# Override only if PayWay instructs a merchant-specific hash field order.
PAYWAY_QR_HASH_FIELDS=req_time,merchant_id,tran_id,amount,items,currency,callback_url,lifetime
PAYWAY_CHECK_HASH_FIELDS=req_time,merchant_id,tran_id
