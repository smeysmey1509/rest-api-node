{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@shared/*": ["./packages/shared/src/*"],
      "@services/*": ["./services/*"],
      "@/*": ["./src/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "types": ["node"],
    "typeRoots": [
      "./node_modules/@types",
      "./src/main/types"
    ]
  },
  "include": ["packages/shared/src/**/*", "services/**/*", "src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/__test__/**",
    "**/*.integration.test.ts",
    "**/*.test.ts"
  ]
}
