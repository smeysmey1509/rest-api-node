NODE_ENV=development
PORT=5002
SERVICE_NAME=api-gateway
MONGO_URI=mongodb://localhost:27017/rest-api-node
AUTH_MONGO_URI=mongodb://localhost:27017/rest-api-node
USER_MONGO_URI=mongodb://localhost:27017/rest-api-node
CATALOG_MONGO_URI=mongodb://localhost:27017/rest-api-node
INVENTORY_MONGO_URI=mongodb://localhost:27017/rest-api-node
ORDER_MONGO_URI=mongodb://localhost:27017/rest-api-node
PAYMENT_MONGO_URI=mongodb://localhost:27017/rest-api-node
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=replace-with-access-token-secret
JWT_REFRESH_SECRET=replace-with-refresh-token-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Optional service-to-service fallback for protected endpoints.
API_KEY=replace-with-service-api-key
API_KEY_USER_ID=service-account
API_KEY_ROLE=ADMIN

# Optional infrastructure.
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localhost:5672
PRODUCT_ACTIVITY_QUEUE=product.activity
PROXY_TARGET=

# API Gateway downstream targets for local non-Docker development.
AUTH_SERVICE_URL=http://localhost:5101
USER_SERVICE_URL=http://localhost:5102
CATALOG_SERVICE_URL=http://localhost:5103
INVENTORY_SERVICE_URL=http://localhost:5104
ORDER_SERVICE_URL=http://localhost:5105
PAYMENT_SERVICE_URL=http://localhost:5106

# Payment config.
# Do not put card numbers, CVV values, or provider secrets in frontend code.
