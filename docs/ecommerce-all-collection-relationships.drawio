        <mxCell id="title" value="Complete e-commerce MongoDB collection relationships" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=28;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="45" as="geometry"/></mxCell>
        <mxCell id="legend" value="★ unique + immutable business identifier   |   PK = MongoDB _id   |   solid arrow = ObjectId/reference   |   dashed arrow = embedded snapshot or polymorphic aggregate reference   |   cardinality is written on each relationship" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12;fontSize=13" vertex="1" parent="1"><mxGeometry x="40" y="75" width="2110" height="55" as="geometry"/></mxCell>

        <mxCell id="lane-id" value="IDENTITY / ACCESS" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="160" width="430" height="1840" as="geometry"/></mxCell>
        <mxCell id="lane-cat" value="CATALOG" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="490" y="160" width="490" height="1840" as="geometry"/></mxCell>
        <mxCell id="lane-inv" value="PROCUREMENT / INVENTORY" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1000" y="160" width="520" height="1840" as="geometry"/></mxCell>
        <mxCell id="lane-sales" value="CART / ORDER" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1540" y="160" width="440" height="1840" as="geometry"/></mxCell>
        <mxCell id="lane-bill" value="PAYMENT / BILLING / FULFILLMENT" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="2000" y="160" width="540" height="1840" as="geometry"/></mxCell>
        <mxCell id="lane-ops" value="RELIABILITY / OPERATIONS" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1" vertex="1" parent="1"><mxGeometry x="2560" y="160" width="500" height="1840" as="geometry"/></mxCell>

        <mxCell id="roles" value="&lt;b&gt;roles&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ roleCode&lt;br&gt;name / permissions[]&lt;br&gt;status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="80" y="225" width="350" height="110" as="geometry"/></mxCell>
        <mxCell id="users" value="&lt;b&gt;users&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ customerNumber&lt;br&gt;roleId → roles._id&lt;br&gt;email (unique, mutable)&lt;br&gt;name / phone / passwordHash / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="80" y="415" width="350" height="145" as="geometry"/></mxCell>
        <mxCell id="sessions" value="&lt;b&gt;auth_sessions&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;userId → users._id&lt;br&gt;refreshTokenHash unique&lt;br&gt;device / IP / expiresAt / revokedAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="80" y="650" width="350" height="125" as="geometry"/></mxCell>
        <mxCell id="addresses" value="&lt;b&gt;addresses&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;userId → users._id&lt;br&gt;recipient / phone&lt;br&gt;line1 / city / province / country&lt;br&gt;isDefault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="80" y="870" width="350" height="130" as="geometry"/></mxCell>

        <mxCell id="categories" value="&lt;b&gt;categories&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ categoryCode&lt;br&gt;parentId → categories._id&lt;br&gt;name / slug / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="525" y="220" width="195" height="125" as="geometry"/></mxCell>
        <mxCell id="brands" value="&lt;b&gt;brands&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ brandCode&lt;br&gt;name / slug / logo / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="750" y="220" width="195" height="125" as="geometry"/></mxCell>
        <mxCell id="products" value="&lt;b&gt;products&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ productCode&lt;br&gt;categoryId → categories._id&lt;br&gt;brandId → brands._id&lt;br&gt;createdBy → users._id&lt;br&gt;name / slug / trackingType / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="555" y="425" width="360" height="160" as="geometry"/></mxCell>
        <mxCell id="variants" value="&lt;b&gt;product_variants&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ sku&lt;br&gt;productId → products._id&lt;br&gt;barcode unique&lt;br&gt;options / pricing / stockSummary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="555" y="675" width="360" height="135" as="geometry"/></mxCell>
        <mxCell id="reviews" value="&lt;b&gt;reviews&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;productId → products._id&lt;br&gt;userId → users._id&lt;br&gt;orderId / orderLineNumber&lt;br&gt;rating / verified / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="525" y="905" width="195" height="145" as="geometry"/></mxCell>
        <mxCell id="wishlists" value="&lt;b&gt;wishlists&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;userId → users._id (unique)&lt;br&gt;items[].productId → products._id&lt;br&gt;addedAt / note" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="750" y="905" width="195" height="145" as="geometry"/></mxCell>
        <mxCell id="sidebar" value="&lt;b&gt;sidebar_items&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;parentId → sidebar_items._id&lt;br&gt;allowedRoleIds[] → roles._id&lt;br&gt;label / route / sortOrder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="555" y="1150" width="360" height="130" as="geometry"/></mxCell>

        <mxCell id="suppliers" value="&lt;b&gt;suppliers&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ supplierCode&lt;br&gt;name / contact / taxNumber / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1035" y="220" width="205" height="120" as="geometry"/></mxCell>
        <mxCell id="locations" value="&lt;b&gt;stock_locations&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ locationCode&lt;br&gt;name / type / address / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1270" y="220" width="205" height="120" as="geometry"/></mxCell>
        <mxCell id="purchaseOrders" value="&lt;b&gt;purchase_orders&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ purchaseOrderNumber&lt;br&gt;supplierId → suppliers._id&lt;br&gt;locationId → stock_locations._id&lt;br&gt;items[].variantId → product_variants._id&lt;br&gt;createdBy → users._id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1065" y="430" width="375" height="165" as="geometry"/></mxCell>
        <mxCell id="delivery" value="&lt;b&gt;delivery_settings&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ deliveryCode&lt;br&gt;method / baseFee / freeThreshold&lt;br&gt;estimatedDays / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1065" y="680" width="375" height="125" as="geometry"/></mxCell>
        <mxCell id="units" value="&lt;b&gt;inventory_units&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ inventoryUnitNumber&lt;br&gt;variantId / productId / locationId&lt;br&gt;supplierId / purchaseOrderId&lt;br&gt;★ serialNumber / IMEI when present&lt;br&gt;reservationId / sold.orderId&lt;br&gt;AVAILABLE / RESERVED / SOLD / RETURNED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1025" y="900" width="225" height="205" as="geometry"/></mxCell>
        <mxCell id="balances" value="&lt;b&gt;inventory_balances&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;variantId → product_variants._id&lt;br&gt;locationId → stock_locations._id&lt;br&gt;variantId + locationId unique&lt;br&gt;onHand / reserved / available / version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1270" y="900" width="225" height="175" as="geometry"/></mxCell>
        <mxCell id="movements" value="&lt;b&gt;inventory_movements&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;variantId / productId / unitId&lt;br&gt;fromLocationId / toLocationId&lt;br&gt;createdBy → users._id&lt;br&gt;referenceType + referenceId (polymorphic)&lt;br&gt;append-only type / quantity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1025" y="1195" width="225" height="190" as="geometry"/></mxCell>
        <mxCell id="reservations" value="&lt;b&gt;inventory_reservations&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ reservationNumber&lt;br&gt;userId / orderId&lt;br&gt;items[].variantId / unitIds[]&lt;br&gt;ACTIVE / CONSUMED / RELEASED / EXPIRED&lt;br&gt;expiresAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1270" y="1195" width="225" height="190" as="geometry"/></mxCell>

        <mxCell id="carts" value="&lt;b&gt;carts&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;userId → users._id (unique)&lt;br&gt;items[].productId / variantId&lt;br&gt;couponId / deliverySettingId&lt;br&gt;temporary; no public business ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1580" y="225" width="360" height="145" as="geometry"/></mxCell>
        <mxCell id="coupons" value="&lt;b&gt;coupons&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ code&lt;br&gt;type / value / usage limits&lt;br&gt;applicableProductIds[] / categoryIds[]&lt;br&gt;startsAt / expiresAt / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1580" y="465" width="170" height="160" as="geometry"/></mxCell>
        <mxCell id="couponUsages" value="&lt;b&gt;coupon_usages&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;couponId / userId / orderId&lt;br&gt;couponId + orderId unique&lt;br&gt;RESERVED / CONSUMED / RELEASED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1770" y="465" width="170" height="160" as="geometry"/></mxCell>
        <mxCell id="orders" value="&lt;b&gt;orders&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ orderNumber&lt;br&gt;userId / reservationId / couponId&lt;br&gt;deliverySettingId&lt;br&gt;items[].productId / variantId / unitIds[]&lt;br&gt;embedded customer, address, item, price snapshots&lt;br&gt;order / payment / fulfillment / billing statuses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1580" y="740" width="360" height="220" as="geometry"/></mxCell>
        <mxCell id="orderHistory" value="&lt;b&gt;orders.statusHistory[] (embedded)&lt;/b&gt;&lt;br&gt;from / to / domain&lt;br&gt;message / changedBy / changedAt&lt;br&gt;Immutable history entries; not a separate collection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="1580" y="1070" width="360" height="120" as="geometry"/></mxCell>

        <mxCell id="payments" value="&lt;b&gt;payments&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ paymentNumber&lt;br&gt;orderId / userId / invoiceId&lt;br&gt;idempotencyKey unique + immutable&lt;br&gt;providerReference / amount / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2035" y="220" width="220" height="165" as="geometry"/></mxCell>
        <mxCell id="paymentEvents" value="&lt;b&gt;payment_events&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;providerEventId unique + immutable&lt;br&gt;paymentId → payments._id&lt;br&gt;signatureVerified / payload / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2280" y="220" width="220" height="165" as="geometry"/></mxCell>
        <mxCell id="invoices" value="&lt;b&gt;invoices&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ invoiceNumber&lt;br&gt;orderId unique + immutable&lt;br&gt;userId&lt;br&gt;embedded customer/items/payment allocations&lt;br&gt;total / paid / balance / CLOSED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2035" y="490" width="220" height="185" as="geometry"/></mxCell>
        <mxCell id="receipts" value="&lt;b&gt;receipts&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ receiptNumber&lt;br&gt;invoiceId / orderId&lt;br&gt;paymentId unique + immutable&lt;br&gt;amount / method / receivedAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2280" y="490" width="220" height="185" as="geometry"/></mxCell>
        <mxCell id="shipments" value="&lt;b&gt;shipments&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ shipmentNumber&lt;br&gt;orderId → orders._id&lt;br&gt;items[].orderLineNumber / unitIds[]&lt;br&gt;trackingNumber / carrier / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2035" y="785" width="220" height="170" as="geometry"/></mxCell>
        <mxCell id="returns" value="&lt;b&gt;returns&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ returnNumber&lt;br&gt;orderId / userId&lt;br&gt;items[].orderLineNumber / unitIds[]&lt;br&gt;reason / resolution / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2280" y="785" width="220" height="170" as="geometry"/></mxCell>
        <mxCell id="refunds" value="&lt;b&gt;refunds&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ refundNumber&lt;br&gt;returnId / paymentId / orderId&lt;br&gt;amount / providerReference / status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2035" y="1060" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="creditNotes" value="&lt;b&gt;credit_notes&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ creditNoteNumber&lt;br&gt;invoiceId / refundId / orderId&lt;br&gt;items + financial correction snapshot&lt;br&gt;original closed invoice remains unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2280" y="1060" width="220" height="165" as="geometry"/></mxCell>

        <mxCell id="sequences" value="&lt;b&gt;number_sequences&lt;/b&gt;&lt;br&gt;PK sequenceKey&lt;br&gt;nextValue&lt;br&gt;year / branch&lt;br&gt;Atomic $inc generates sequential PO, invoice, receipt and credit-note numbers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2600" y="225" width="420" height="145" as="geometry"/></mxCell>
        <mxCell id="outbox" value="&lt;b&gt;outbox_events&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;eventId unique + immutable&lt;br&gt;aggregateType + aggregateId (polymorphic)&lt;br&gt;name / payload / publishStatus / attempts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2600" y="470" width="200" height="165" as="geometry"/></mxCell>
        <mxCell id="inbox" value="&lt;b&gt;inbox_events&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;eventId + consumer unique&lt;br&gt;source / payload&lt;br&gt;processingStatus / attempts / error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2820" y="470" width="200" height="165" as="geometry"/></mxCell>
        <mxCell id="notifications" value="&lt;b&gt;notifications&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;userId → users._id&lt;br&gt;sourceEventId → inbox/outbox eventId&lt;br&gt;channel / template / destination&lt;br&gt;QUEUED / SENT / FAILED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2600" y="745" width="200" height="165" as="geometry"/></mxCell>
        <mxCell id="audit" value="&lt;b&gt;audit_logs&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;actorUserId → users._id&lt;br&gt;targetType + targetId (polymorphic)&lt;br&gt;action / before / after / requestId&lt;br&gt;append-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2820" y="745" width="200" height="165" as="geometry"/></mxCell>
        <mxCell id="jobs" value="&lt;b&gt;scheduled_jobs / job_locks&lt;/b&gt;&lt;br&gt;PK _id&lt;br&gt;★ jobKey&lt;br&gt;lockedBy / lockedUntil&lt;br&gt;lastRun / nextRun / status&lt;br&gt;reservation expiry, reconciliation, retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="2600" y="1020" width="420" height="145" as="geometry"/></mxCell>

        <mxCell id="e-role-user" value="1 role : N users" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="roles" target="users"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-user-session" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="users" target="sessions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-user-address" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="users" target="addresses"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-cat-self" value="parent 0..1 : N children" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERzeroToOne" edge="1" parent="1" source="categories" target="categories"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="250"/><mxPoint x="500" y="330"/></Array></mxGeometry></mxCell>
        <mxCell id="e-cat-product" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="categories" target="products"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-brand-product" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="brands" target="products"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-product-variant" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="products" target="variants"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-product-review" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="products" target="reviews"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-user-review" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="users" target="reviews"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-user-wishlist" value="1 : 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERzeroToOne;startArrow=ERone" edge="1" parent="1" source="users" target="wishlists"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-product-wishlist" value="N : N embedded items" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1" edge="1" parent="1" source="products" target="wishlists"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-sidebar-role" value="N : N visibility" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1" edge="1" parent="1" source="roles" target="sidebar"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-po-supplier" value="1 supplier : N PO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="suppliers" target="purchaseOrders"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-po-location" value="1 location : N PO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="locations" target="purchaseOrders"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-po-variant" value="N : N line items" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1" edge="1" parent="1" source="variants" target="purchaseOrders"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-variant-unit" value="1 : N serialized" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="variants" target="units"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-variant-balance" value="1 : N locations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="variants" target="balances"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-location-unit" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="locations" target="units"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-po-unit" value="1 : N received units" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="purchaseOrders" target="units"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-unit-move" value="1 : N audit entries" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERzeroToOne" edge="1" parent="1" source="units" target="movements"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-unit-reserve" value="N : N reserved items" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1" edge="1" parent="1" source="units" target="reservations"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-user-cart" value="1 : 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERzeroToOne;startArrow=ERone" edge="1" parent="1" source="users" target="carts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-variant-cart" value="N : N embedded items" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1" edge="1" parent="1" source="variants" target="carts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-coupon-cart" value="1 : N optional" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERzeroToOne" edge="1" parent="1" source="coupons" target="carts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-delivery-cart" value="1 : N optional" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERzeroToOne" edge="1" parent="1" source="delivery" target="carts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-user-order" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="users" target="orders"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-cart-order" value="0..1 cart → N orders over time" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1" edge="1" parent="1" source="carts" target="orders"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-res-order" value="1 : 1 active checkout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERone;startArrow=ERone" edge="1" parent="1" source="reservations" target="orders"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-coupon-usage" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="coupons" target="couponUsages"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-order-usage" value="1 : 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERzeroToOne;startArrow=ERone" edge="1" parent="1" source="orders" target="couponUsages"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-order-payment" value="1 : N attempts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="orders" target="payments"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-payment-event" value="1 : N webhook events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="payments" target="paymentEvents"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-order-invoice" value="1 : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERone;startArrow=ERone" edge="1" parent="1" source="orders" target="invoices"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-invoice-receipt" value="1 : N allocations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="invoices" target="receipts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-payment-receipt" value="1 : 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERzeroToOne;startArrow=ERone" edge="1" parent="1" source="payments" target="receipts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-order-shipment" value="1 : N packages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="orders" target="shipments"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-order-return" value="1 : N return requests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="orders" target="returns"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-return-refund" value="1 : N refund attempts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="returns" target="refunds"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-payment-refund" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="payments" target="refunds"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-invoice-credit" value="1 : N corrections" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="invoices" target="creditNotes"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-refund-credit" value="1 : 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERzeroToOne;startArrow=ERone" edge="1" parent="1" source="refunds" target="creditNotes"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-user-notify" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="users" target="notifications"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-user-audit" value="1 : N actions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERzeroToOne" edge="1" parent="1" source="users" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-out-in" value="1 event : N consumers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone" edge="1" parent="1" source="outbox" target="inbox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-in-notify" value="1 : 0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERzeroToOne" edge="1" parent="1" source="inbox" target="notifications"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-order-outbox" value="aggregate reference" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1" edge="1" parent="1" source="orders" target="outbox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-payment-outbox" value="aggregate reference" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1" edge="1" parent="1" source="payments" target="outbox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-seq-invoice" value="generates ★ numbers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1" edge="1" parent="1" source="sequences" target="invoices"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="reference-catalog" name="2. Reference Catalog">
    <mxGraphModel dx="2200" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1750" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="r-title" value="Field-level relationship catalog" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=28;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="45" as="geometry"/></mxCell>
        <mxCell id="r-sub" value="Use this page when implementing Mongoose fields, populate calls, API contracts, delete policies, and migration scripts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1200" height="50" as="geometry"/></mxCell>

        <mxCell id="r1" value="&lt;b&gt;Identity relationships&lt;/b&gt;&lt;br&gt;&lt;br&gt;users.roleId → roles._id  [N:1, RESTRICT role delete]&lt;br&gt;auth_sessions.userId → users._id  [N:1, CASCADE]&lt;br&gt;addresses.userId → users._id  [N:1, CASCADE]&lt;br&gt;carts.userId → users._id  [1:1, CASCADE]&lt;br&gt;wishlists.userId → users._id  [1:1, CASCADE]&lt;br&gt;orders.userId → users._id  [N:1, preserve on account deletion]&lt;br&gt;reviews.userId → users._id  [N:1, anonymize/preserve]&lt;br&gt;coupon_usages.userId → users._id  [N:1, preserve]&lt;br&gt;inventory_reservations.userId → users._id  [N:1]&lt;br&gt;payments.userId → users._id  [N:1, preserve]&lt;br&gt;returns.userId → users._id  [N:1, preserve]&lt;br&gt;notifications.userId → users._id  [N:1]&lt;br&gt;audit_logs.actorUserId → users._id  [N:0..1, preserve]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=13" vertex="1" parent="1"><mxGeometry x="40" y="165" width="570" height="455" as="geometry"/></mxCell>
        <mxCell id="r2" value="&lt;b&gt;Catalog relationships&lt;/b&gt;&lt;br&gt;&lt;br&gt;categories.parentId → categories._id  [N:0..1]&lt;br&gt;products.categoryId → categories._id  [N:1, RESTRICT]&lt;br&gt;products.brandId → brands._id  [N:1, RESTRICT]&lt;br&gt;products.createdBy → users._id  [N:0..1]&lt;br&gt;product_variants.productId → products._id  [N:1, CASCADE only before sales]&lt;br&gt;reviews.productId → products._id  [N:1, preserve/soft-delete product]&lt;br&gt;reviews.orderId → orders._id  [N:0..1]&lt;br&gt;wishlists.items[].productId → products._id  [N:N embedded]&lt;br&gt;sidebar_items.parentId → sidebar_items._id  [N:0..1]&lt;br&gt;sidebar_items.allowedRoleIds[] → roles._id  [N:N]&lt;br&gt;coupons.applicableProductIds[] → products._id  [N:N]&lt;br&gt;coupons.applicableCategoryIds[] → categories._id  [N:N]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=13" vertex="1" parent="1"><mxGeometry x="640" y="165" width="570" height="455" as="geometry"/></mxCell>
        <mxCell id="r3" value="&lt;b&gt;Procurement and inventory relationships&lt;/b&gt;&lt;br&gt;&lt;br&gt;purchase_orders.supplierId → suppliers._id  [N:1, RESTRICT]&lt;br&gt;purchase_orders.locationId → stock_locations._id  [N:1, RESTRICT]&lt;br&gt;purchase_orders.items[].variantId → product_variants._id  [N:N embedded]&lt;br&gt;purchase_orders.createdBy → users._id  [N:1]&lt;br&gt;inventory_units.productId → products._id  [N:1]&lt;br&gt;inventory_units.variantId → product_variants._id  [N:1]&lt;br&gt;inventory_units.locationId → stock_locations._id  [N:1]&lt;br&gt;inventory_units.supplierId → suppliers._id  [N:0..1]&lt;br&gt;inventory_units.purchaseOrderId → purchase_orders._id  [N:0..1]&lt;br&gt;inventory_units.reservationId → inventory_reservations._id  [N:0..1]&lt;br&gt;inventory_units.sold.orderId → orders._id  [N:0..1]&lt;br&gt;inventory_balances.variantId → product_variants._id  [N:1]&lt;br&gt;inventory_balances.locationId → stock_locations._id  [N:1]&lt;br&gt;inventory_movements.inventoryUnitId → inventory_units._id  [N:0..1]&lt;br&gt;inventory_movements.from/toLocationId → stock_locations._id [N:0..1]&lt;br&gt;inventory_movements.referenceId → PO/order/return/transfer [polymorphic]&lt;br&gt;inventory_reservations.items[].unitIds[] → inventory_units._id [N:N]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=13" vertex="1" parent="1"><mxGeometry x="1240" y="165" width="600" height="455" as="geometry"/></mxCell>
        <mxCell id="r4" value="&lt;b&gt;Cart, coupon, and order relationships&lt;/b&gt;&lt;br&gt;&lt;br&gt;carts.items[].productId → products._id  [N:N embedded]&lt;br&gt;carts.items[].variantId → product_variants._id  [N:N embedded]&lt;br&gt;carts.couponId → coupons._id  [N:0..1]&lt;br&gt;carts.deliverySettingId → delivery_settings._id  [N:0..1]&lt;br&gt;coupon_usages.couponId → coupons._id  [N:1]&lt;br&gt;coupon_usages.orderId → orders._id  [1:1 per coupon/order]&lt;br&gt;orders.reservationId → inventory_reservations._id  [1:1]&lt;br&gt;orders.couponId → coupons._id  [N:0..1 plus snapshot]&lt;br&gt;orders.deliverySettingId → delivery_settings._id  [N:0..1 plus snapshot]&lt;br&gt;orders.items[].productId → products._id  [N:N plus immutable snapshot]&lt;br&gt;orders.items[].variantId → product_variants._id  [N:N plus immutable snapshot]&lt;br&gt;orders.items[].inventoryUnitIds[] → inventory_units._id [N:N]&lt;br&gt;orders.statusHistory[].changedBy → users._id [embedded N:0..1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=13" vertex="1" parent="1"><mxGeometry x="1870" y="165" width="570" height="455" as="geometry"/></mxCell>

        <mxCell id="r5" value="&lt;b&gt;Payment and invoice relationships&lt;/b&gt;&lt;br&gt;&lt;br&gt;payments.orderId → orders._id  [N:1; supports retry attempts]&lt;br&gt;payments.invoiceId → invoices._id  [N:0..1]&lt;br&gt;payment_events.paymentId → payments._id  [N:1]&lt;br&gt;invoices.orderId → orders._id  [1:1 unique + immutable]&lt;br&gt;invoices.userId → users._id  [N:1 plus customer snapshot]&lt;br&gt;invoices.paymentAllocations[].paymentId → payments._id  [N:N embedded]&lt;br&gt;receipts.invoiceId → invoices._id  [N:1]&lt;br&gt;receipts.orderId → orders._id  [N:1]&lt;br&gt;receipts.paymentId → payments._id  [0..1:1 unique]&lt;br&gt;refunds.paymentId → payments._id  [N:1]&lt;br&gt;refunds.orderId → orders._id  [N:1]&lt;br&gt;credit_notes.invoiceId → invoices._id  [N:1]&lt;br&gt;credit_notes.refundId → refunds._id  [0..1:1]&lt;br&gt;credit_notes.orderId → orders._id  [N:1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=13" vertex="1" parent="1"><mxGeometry x="40" y="665" width="570" height="435" as="geometry"/></mxCell>
        <mxCell id="r6" value="&lt;b&gt;Fulfillment and return relationships&lt;/b&gt;&lt;br&gt;&lt;br&gt;shipments.orderId → orders._id  [N:1; multiple packages allowed]&lt;br&gt;shipments.items[].inventoryUnitIds[] → inventory_units._id [N:N]&lt;br&gt;shipments.items[].orderLineNumber → embedded order item [logical ref]&lt;br&gt;returns.orderId → orders._id  [N:1]&lt;br&gt;returns.items[].inventoryUnitIds[] → inventory_units._id [N:N]&lt;br&gt;returns.items[].orderLineNumber → embedded order item [logical ref]&lt;br&gt;refunds.returnId → returns._id  [N:1; retry/partial refunds]&lt;br&gt;inventory_movements.referenceId → returns._id when referenceType=RETURN&lt;br&gt;closed invoice → credit note rather than invoice mutation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=13" vertex="1" parent="1"><mxGeometry x="640" y="665" width="570" height="435" as="geometry"/></mxCell>
        <mxCell id="r7" value="&lt;b&gt;Reliability and operational relationships&lt;/b&gt;&lt;br&gt;&lt;br&gt;outbox_events.aggregateId → order/payment/inventory/shipment/etc. [polymorphic]&lt;br&gt;inbox_events.eventId → outbox_events.eventId logically [1:N consumers]&lt;br&gt;notifications.userId → users._id  [N:1]&lt;br&gt;notifications.sourceEventId → inbox/outbox eventId [logical]&lt;br&gt;audit_logs.actorUserId → users._id  [N:0..1]&lt;br&gt;audit_logs.targetId → any aggregate _id [polymorphic]&lt;br&gt;number_sequences.sequenceKey → business number type/year/branch [logical]&lt;br&gt;scheduled_jobs/job_locks.jobKey → reservation-expiry, retry, reconciliation job [logical]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=13" vertex="1" parent="1"><mxGeometry x="1240" y="665" width="600" height="435" as="geometry"/></mxCell>
        <mxCell id="r8" value="&lt;b&gt;Snapshot vs reference rule&lt;/b&gt;&lt;br&gt;&lt;br&gt;Keep a reference for navigation and integrity.&lt;br&gt;Also embed a snapshot when historical facts must never change:&lt;br&gt;• order items: product name, productCode, SKU, options, unit price&lt;br&gt;• order: customer contact, shipping address, coupon and delivery&lt;br&gt;• invoice: customer, item, tax, payment-allocation details&lt;br&gt;• receipt: payment number, method, amount and transaction reference&lt;br&gt;• credit note: original invoice line and correction values&lt;br&gt;&lt;br&gt;If catalog or user data changes later, historical orders and invoices remain identical." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=13" vertex="1" parent="1"><mxGeometry x="1870" y="665" width="570" height="435" as="geometry"/></mxCell>

        <mxCell id="r9" value="&lt;b&gt;Recommended delete policy&lt;/b&gt;&lt;br&gt;&lt;br&gt;CASCADE only ephemeral child data: sessions, addresses, carts, wishlists, unsent notifications.&lt;br&gt;RESTRICT deletion of referenced master data: roles, categories, brands, variants, suppliers, locations, delivery settings.&lt;br&gt;SOFT DELETE users/products when transactions exist.&lt;br&gt;NEVER DELETE orders, payments, invoices, receipts, inventory movements, refunds, credit notes, audit logs or processed event records.&lt;br&gt;Use retention/anonymization rules for personal data without breaking accounting history." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=13" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="1170" height="240" as="geometry"/></mxCell>
        <mxCell id="r10" value="&lt;b&gt;Database boundary rule&lt;/b&gt;&lt;br&gt;&lt;br&gt;Current V1: ObjectId references and MongoDB transactions require all directly imported Mongoose models to use the same database.&lt;br&gt;&lt;br&gt;Future independent microservices: replace cross-service ObjectId/populate relationships with immutable public IDs, versioned HTTP contracts, event payloads, local snapshots and outbox/inbox delivery. Each service then owns and queries only its own collections." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=13" vertex="1" parent="1"><mxGeometry x="1240" y="1150" width="1200" height="240" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="relationship-chain" name="3. Start to Closed Bill">
    <mxGraphModel dx="2300" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c-title" value="How the collections connect from setup to closed bill" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=28;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="45" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;b&gt;1. Identity&lt;/b&gt;&lt;br&gt;roles → users&lt;br&gt;users → sessions + addresses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="140" width="240" height="105" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;2. Catalog master&lt;/b&gt;&lt;br&gt;categories + brands → products&lt;br&gt;products → variants (SKU + price)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="380" y="140" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;3. Procurement&lt;/b&gt;&lt;br&gt;supplier + location + variant&lt;br&gt;→ purchase_order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="740" y="140" width="260" height="105" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;4. Stock-in&lt;/b&gt;&lt;br&gt;PO → units or balances&lt;br&gt;→ inventory movement&lt;br&gt;→ derived variant stockSummary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1080" y="130" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;5. Shopping&lt;/b&gt;&lt;br&gt;user + variant&lt;br&gt;→ wishlist / cart&lt;br&gt;cart → coupon + delivery setting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1440" y="130" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;6. Checkout&lt;/b&gt;&lt;br&gt;cart + user + coupon&lt;br&gt;→ inventory reservation&lt;br&gt;→ immutable order snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1800" y="130" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;7. Payment&lt;/b&gt;&lt;br&gt;order → payment attempts&lt;br&gt;payment → webhook events&lt;br&gt;success consumes reservation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="2160" y="130" width="280" height="125" as="geometry"/></mxCell>

        <mxCell id="c8" value="&lt;b&gt;8. Stock sale&lt;/b&gt;&lt;br&gt;reservation ACTIVE → CONSUMED&lt;br&gt;units RESERVED → SOLD&lt;br&gt;create SOLD movement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="2160" y="430" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;9. Billing&lt;/b&gt;&lt;br&gt;order → one invoice&lt;br&gt;successful payments → allocations&lt;br&gt;payment → receipt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1800" y="430" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;10. Fulfillment&lt;/b&gt;&lt;br&gt;order → one or more shipments&lt;br&gt;shipment items → order lines + unit IDs&lt;br&gt;status → DELIVERED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1440" y="420" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b&gt;11. Close bill&lt;/b&gt;&lt;br&gt;invoice balance = 0&lt;br&gt;payment SUCCESS + shipment DELIVERED&lt;br&gt;invoice CLOSED + order COMPLETED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1080" y="420" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b&gt;12. Return after close&lt;/b&gt;&lt;br&gt;order → return&lt;br&gt;return + payment → refund&lt;br&gt;closed invoice → credit note&lt;br&gt;never mutate original invoice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="720" y="410" width="280" height="160" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;b&gt;13. Reliability around every write&lt;/b&gt;&lt;br&gt;transaction writes aggregate + outbox event&lt;br&gt;consumer stores inbox event before processing&lt;br&gt;audit log records privileged changes&lt;br&gt;notifications link to event + user&lt;br&gt;workers expire reservations and reconcile payments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1" vertex="1" parent="1"><mxGeometry x="260" y="400" width="360" height="180" as="geometry"/></mxCell>

        <mxCell id="failure" value="&lt;b&gt;Failure compensation&lt;/b&gt;&lt;br&gt;Payment FAILED / timeout&lt;br&gt;→ reservation RELEASED&lt;br&gt;→ units AVAILABLE / balance reserved decremented&lt;br&gt;→ coupon usage RELEASED&lt;br&gt;→ order FAILED or CANCELLED&lt;br&gt;→ cart retained/restored" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10" vertex="1" parent="1"><mxGeometry x="1770" y="700" width="330" height="180" as="geometry"/></mxCell>
        <mxCell id="cod" value="&lt;b&gt;Cash on delivery variation&lt;/b&gt;&lt;br&gt;Create order + reservation without online SUCCESS.&lt;br&gt;Keep payment PENDING while processing/shipping.&lt;br&gt;At delivery: collect cash → payment SUCCESS → receipt → invoice PAID/CLOSED.&lt;br&gt;Failed delivery releases/returns stock and cancels payment/order." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10" vertex="1" parent="1"><mxGeometry x="1120" y="700" width="530" height="180" as="geometry"/></mxCell>
        <mxCell id="invariants" value="&lt;b&gt;Relationship invariants&lt;/b&gt;&lt;br&gt;• Exactly one active cart per user&lt;br&gt;• Exactly one inventory balance per variant + location&lt;br&gt;• Exactly one active reservation per order&lt;br&gt;• Multiple payment attempts allowed; only idempotent success affects stock&lt;br&gt;• Exactly one invoice per order&lt;br&gt;• At most one receipt per successful payment&lt;br&gt;• Multiple shipments/returns/refunds allowed&lt;br&gt;• Closed financial records are never deleted or edited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10" vertex="1" parent="1"><mxGeometry x="260" y="700" width="700" height="180" as="geometry"/></mxCell>

        <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce11" value="optional return" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce12" value="provider failure / expiry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450" edge="1" parent="1" source="c7" target="failure"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce13" value="COD branch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1" edge="1" parent="1" source="c6" target="cod"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
